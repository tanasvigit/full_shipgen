            "text": "import.meta.env = {\"BASE_URL\": \"/\", \"DEV\": true, \"MODE\": \"development\", \"PROD\": false, \"SSR\": false, \"VITE_API_HOST\": \"http://localhost:8000\", \"VITE_API_NAMESPACE\": \"int/v1\", \"VITE_API_TIMEOUT_MS\": \"20000\", \"VITE_GOOGLE_MAPS_API_KEY\": \"AIzaSyAtvTmSrx1arTFcg1yot8kFn1ClG-jhQcE\", \"VITE_INSTALLER_API_TIMEOUT_MS\": \"600000\", \"VITE_LEDGER_MODULE_ROOT\": \"ledger/int/v1\", \"VITE_MAP_TILE_ATTRIBUTION\": \"© OpenStreetMap contributors\", \"VITE_MAP_TILE_URL\": \"http://localhost:8080/styles/basic/{z}/{x}/{y}.png\", \"VITE_MAP_TILE_URL_DARK\": \"http://localhost:8080/styles/basic/{z}/{x}/{y}.png\", \"VITE_PALLET_MODULE_ROOT\": \"pallet/int/v1\", \"VITE_REGISTRY_MODULE_ROOT\": \"~registry/v1\", \"VITE_SOCKETCLUSTER_PROXY\": \"true\", \"VITE_STOREFRONT_MODULE_ROOT\": \"storefront/int/v1\", \"VITE_TWO_FA_ENABLED\": \"false\"};function redactedMessage(value) {\r\n  const text = String(value || \"\");\r\n  return text.slice(0, 240);\r\n}\r\n\r\nexport function logOnboardingDebug(event, payload = {}) {\r\n  if (!import.meta.env?.DEV) return;\r\n  const safePayload = {\r\n    route: payload.route || \"unknown\",\r\n    action: payload.action || \"unknown\",\r\n    status: payload.status ?? null,\r\n    code: payload.code ?? null,\r\n    message: redactedMessage(payload.message),\r\n  };\r\n  // Never include sensitive values (password/token/code).\r\n  console.debug(`[onboarding] ${event}`, safePayload);\r\n}\r\n\r\n\n//# sourceMappingURL=data:application/json;base64,"
