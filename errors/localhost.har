            "mimeType": "text/javascript",
            "compression": 0,
            "text": "import { createHotContext as __vite__createHotContext } from \"/@vite/client\";import.meta.hot = __vite__createHotContext(\"/src/components/loaders/Spinner/spinner.css\");import { updateStyle as __vite__updateStyle, removeStyle as __vite__removeStyle } from \"/@vite/client\"\nconst __vite__id = \"D:/fleetbase/frontend/src/components/loaders/Spinner/spinner.css\"\nconst __vite__css = \"/**\\r\\n * Fleetbase arc spinner — transform-only rotation, GPU-friendly, seamless loop.\\r\\n * Spec: clockwise rotation, rounded cap, consistent arc length, fade-in, no scale/pulse.\\r\\n */\\r\\n\\r\\n:root {\\r\\n  --loader-arc: #0066ff;\\r\\n  --loader-track: rgba(0, 0, 0, 0.08);\\r\\n  --loader-message: #374151;\\r\\n  --loader-overlay: rgba(255, 255, 255, 0.72);\\r\\n  --loader-progress: #0066ff;\\r\\n}\\r\\n\\r\\n.dark,\\r\\n[data-theme=\\\"dark\\\"] {\\r\\n  --loader-arc: #3b82f6;\\r\\n  --loader-track: rgba(255, 255, 255, 0.12);\\r\\n  --loader-message: #e5e7eb;\\r\\n  --loader-overlay: rgba(10, 14, 26, 0.75);\\r\\n  --loader-progress: #3b82f6;\\r\\n}\\r\\n\\r\\n@keyframes fleetbase-loader-fade-in {\\r\\n  from {\\r\\n    opacity: 0;\\r\\n  }\\r\\n  to {\\r\\n    opacity: 1;\\r\\n  }\\r\\n}\\r\\n\\r\\n@keyframes fleetbase-arc-spin {\\r\\n  to {\\r\\n    transform: rotate(360deg);\\r\\n  }\\r\\n}\\r\\n\\r\\n@keyframes fleetbase-loader-fade-out {\\r\\n  from {\\r\\n    opacity: 1;\\r\\n  }\\r\\n  to {\\r\\n    opacity: 0;\\r\\n  }\\r\\n}\\r\\n\\r\\n@keyframes fleetbase-progress-indeterminate {\\r\\n  0% {\\r\\n    transform: translateX(-100%);\\r\\n  }\\r\\n  100% {\\r\\n    transform: translateX(400%);\\r\\n  }\\r\\n}\\r\\n\\r\\n.fleetbase-loader-fade-in {\\r\\n  animation: fleetbase-loader-fade-in 0.22s ease-out forwards;\\r\\n  will-change: opacity;\\r\\n}\\r\\n\\r\\n.fleetbase-loader-fade-out {\\r\\n  animation: fleetbase-loader-fade-out 0.18s ease-in forwards;\\r\\n}\\r\\n\\r\\n/** Fixed box so flex centering and rotation never drift from viewport center */\\r\\n.fleetbase-arc-spinner-host {\\r\\n  display: inline-flex;\\r\\n  align-items: center;\\r\\n  justify-content: center;\\r\\n  flex-shrink: 0;\\r\\n  line-height: 0;\\r\\n  vertical-align: middle;\\r\\n}\\r\\n\\r\\n.fleetbase-arc-spinner {\\r\\n  display: block;\\r\\n  flex-shrink: 0;\\r\\n  transform-origin: 50% 50%;\\r\\n  animation: fleetbase-arc-spin 0.9s linear infinite;\\r\\n  will-change: transform;\\r\\n}\\r\\n\\r\\n/** Full-viewport centered overlay shell (bootstrap, tables, pages, refresh) */\\r\\n.fleetbase-loader-viewport {\\r\\n  position: fixed;\\r\\n  top: 0;\\r\\n  right: 0;\\r\\n  bottom: 0;\\r\\n  left: 0;\\r\\n  width: 100%;\\r\\n  height: 100%;\\r\\n  z-index: 99990;\\r\\n  display: flex;\\r\\n  flex-direction: row;\\r\\n  align-items: center;\\r\\n  justify-content: center;\\r\\n  box-sizing: border-box;\\r\\n  pointer-events: none;\\r\\n}\\r\\n\\r\\n.fleetbase-loader-viewport--interactive {\\r\\n  pointer-events: auto;\\r\\n}\\r\\n\\r\\n.fleetbase-arc-spinner__track {\\r\\n  stroke: var(--loader-track);\\r\\n}\\r\\n\\r\\n.fleetbase-arc-spinner__arc {\\r\\n  stroke: var(--loader-arc);\\r\\n}\\r\\n\\r\\n@media (prefers-reduced-motion: reduce) {\\r\\n  .fleetbase-arc-spinner {\\r\\n    animation: none;\\r\\n  }\\r\\n\\r\\n  .fleetbase-route-progress__bar {\\r\\n    animation: none !important;\\r\\n    width: 35% !important;\\r\\n    transform: none !important;\\r\\n  }\\r\\n}\\r\\n\\r\\n.fleetbase-route-progress {\\r\\n  position: fixed;\\r\\n  top: 0;\\r\\n  left: 0;\\r\\n  right: 0;\\r\\n  height: 2px;\\r\\n  z-index: 99998;\\r\\n  pointer-events: none;\\r\\n  overflow: hidden;\\r\\n  opacity: 0;\\r\\n  transition: opacity 0.2s ease;\\r\\n}\\r\\n\\r\\n.fleetbase-route-progress[data-active=\\\"true\\\"] {\\r\\n  opacity: 1;\\r\\n}\\r\\n\\r\\n.fleetbase-route-progress__bar {\\r\\n  height: 100%;\\r\\n  width: 28%;\\r\\n  background: var(--loader-progress);\\r\\n  border-radius: 0 2px 2px 0;\\r\\n  transform: translateX(-100%);\\r\\n  animation: fleetbase-progress-indeterminate 1.1s ease-in-out infinite;\\r\\n  will-change: transform;\\r\\n}\\r\\n\"\n__vite__updateStyle(__vite__id, __vite__css)\nimport.meta.hot.accept()\nimport.meta.hot.prune(() => __vite__removeStyle(__vite__id))"
