# FleetOps React — production environment template
VITE_API_HOST=http://localhost:8000
VITE_API_NAMESPACE=int/v1
VITE_API_TIMEOUT_MS=20000
# First-time installer migrate/seed can exceed the default API timeout.
VITE_INSTALLER_API_TIMEOUT_MS=600000

# Optional module roots (Fleetbase extensions)
VITE_LEDGER_MODULE_ROOT=ledger/int/v1
VITE_STOREFRONT_MODULE_ROOT=storefront/int/v1
VITE_PALLET_MODULE_ROOT=pallet/int/v1
VITE_REGISTRY_MODULE_ROOT=~registry/v1

# Realtime — Vite dev proxies /socketcluster/ to Docker socket (:38000)
VITE_SOCKETCLUSTER_PROXY=true
# Or connect directly (set proxy false):
# VITE_SOCKETCLUSTER_PROXY=false
# VITE_SOCKETCLUSTER_HOST=localhost
# VITE_SOCKETCLUSTER_PORT=38000

# Google Maps JavaScript API (Places Autocomplete, Geocoding, Directions).
# Enable Maps JavaScript API, Places API, Geocoding API, and Directions API in GCP.
# VITE_GOOGLE_MAPS_API_KEY=your-key-here

# Map tiles — Leaflet fallback when VITE_GOOGLE_MAPS_API_KEY is unset
VITE_MAP_TILE_URL=http://localhost:8080/styles/basic/{z}/{x}/{y}.png
VITE_MAP_TILE_URL_DARK=http://localhost:8080/styles/basic/{z}/{x}/{y}.png
VITE_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors

# Two-factor authentication UI (login verification + account/IAM toggles). Default off.
# VITE_TWO_FA_ENABLED=true
