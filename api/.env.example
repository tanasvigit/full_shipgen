APP_NAME=shipgen-fleet
APP_ENV=development
APP_KEY=base64:VdK0fGjuKjIKQFWjrpZdNH4Y9x+qbLaXxU3t7tBLeew=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=database
DB_PORT=3306
DB_DATABASE=fleetbase
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=socketcluster
CACHE_DRIVER=redis
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=cache

REDIS_HOST=cache
REDIS_CLIENT=phpredis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=noreply@shipgen.net
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@shipgen.net
MAIL_FROM_NAME=Shipgen
MAIL_DEFAULT_MAILBOX=support
MAIL_SALES_ADDRESS=sales@shipgen.net
MAIL_SUPPORT_ADDRESS=support@shipgen.net
MAIL_NOREPLY_ADDRESS=noreply@shipgen.net
MAIL_BILLING_ADDRESS=billing@shipgen.net

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

FRONTEND_HOSTS=http://localhost:5173,http://localhost:4300,http://192.168.0.171:5173

TELEMETRY_DISABLED=true
REGISTRY_PREINSTALLED_EXTENSIONS=true
CONSOLE_HOST=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1:5173,127.0.0.1,127.0.0.1:8000
INSTALLER_UI_ENABLED=false
INSTALLER_RUNTIME_SETUP_ENABLED=false
DEPLOY_CREATE_DB=true
DEPLOY_RUN_SEED=never
DEPLOY_RUN_PERMISSIONS_SYNC=true
DEPLOY_RUN_REGISTRY_INIT=true

# Self-hosted OSRM (docker compose services osrm-backend + osrm). Run scripts/setup-osrm.ps1 once.
OSRM_HOST=http://osrm-backend:5000
OSRM_TIMEOUT=30

# API gateway (must match docker-compose gateway + application)
GATEWAY_INTERNAL_SECRET=shipgen-gateway-dev-secret
GATEWAY_JWT_SECRET=shipgen-jwt-dev-secret-change-in-prod
GATEWAY_JWT_ISSUER=shipgen-iam
GATEWAY_JWT_AUDIENCE=shipgen-internal
GATEWAY_TRUST_INTERNAL_JWT=false