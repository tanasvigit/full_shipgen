APP_NAME=shipgen-fleet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=redis
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Google Sign-In (OAuth 2.0 Web client — same Client ID as VITE_GOOGLE_CLIENT_ID in frontend)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# On-prem (no fleetbase.io runtime calls by default)
TELEMETRY_DISABLED=true
# TELEMETRY_ENDPOINT=
REGISTRY_PREINSTALLED_EXTENSIONS=true
# REGISTRY_HOST=
# React app URL (CORS + links in emails). Docker compose serves frontend on :5173.
CONSOLE_HOST=http://localhost:5173
FRONTEND_HOSTS=http://localhost:5173
# FLEETBASE_BLOG_RSS_URL=

# Self-hosted OSRM (see docker/osrm/README.md and scripts/setup-osrm.ps1)
OSRM_HOST=http://osrm-backend:5000
OSRM_TIMEOUT=30

# Map tiles (Leaflet — host TileServer GL or similar; browser uses CONSOLE_HOST:8080)
MAP_TILE_URL=http://localhost:8080/styles/basic/{z}/{x}/{y}.png
MAP_TILE_URL_DARK=http://localhost:8080/styles/basic/{z}/{x}/{y}.png
MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
MAP_TILE_MAX_ZOOM=19

# Default images (served from api/public/defaults — no flb-assets CDN)
ASSET_PUBLIC_BASE_URL=http://localhost:8000
FLEETBASE_ASSETS_S3_BUCKET=

# API gateway / internal service JWT (microservices — see docs/MICROSERVICES-ARCHITECTURE.md)
GATEWAY_INTERNAL_SECRET=shipgen-gateway-dev-secret
GATEWAY_JWT_SECRET=shipgen-jwt-dev-secret-change-in-prod
GATEWAY_JWT_ISSUER=shipgen-iam
GATEWAY_JWT_AUDIENCE=shipgen-internal
GATEWAY_JWT_TTL=900
GATEWAY_TRUST_INTERNAL_JWT=false

# Self-hosted assets (optional overrides; paths are under api/public/defaults)
# DEFAULT_USER_IMAGE=
# DEFAULT_DRIVER_IMAGE=
