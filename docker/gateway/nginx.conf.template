# API Gateway — path routing + session introspection (auth_request).
# IAM → iam-service | FleetOps → fleetops-service | Pallet → pallet-service

resolver 127.0.0.11 valid=10s ipv6=off;

upstream monolith {
    zone gateway_monolith 64k;
    server application:8000 resolve;
}

upstream iam_upstream {
    zone gateway_iam 64k;
    server iam-service:8000 resolve;
}

upstream fleetops_upstream {
    zone gateway_fleetops 64k;
    server fleetops-service:8000 resolve;
}

upstream pallet_upstream {
    zone gateway_pallet 64k;
    server pallet-service:8000 resolve;
}

upstream ledger_upstream {
    zone gateway_ledger 64k;
    server ledger-service:8000 resolve;
}

upstream storefront_upstream {
    zone gateway_storefront 64k;
    server storefront-service:8000 resolve;
}

upstream yms_upstream {
    zone gateway_yms 64k;
    server yms-service:8000 resolve;
}

upstream pms_upstream {
    zone gateway_pms 64k;
    server pms-service:8000 resolve;
}

map $http_origin $cors_allow_origin {
    default "";
    "~^https?://localhost(:[0-9]+)?$" $http_origin;
    "~^https?://127\.0\.0\.1(:[0-9]+)?$" $http_origin;
    "~^https?://192\.168\.[0-9.]+(:[0-9]+)?$" $http_origin;
}

server {
    listen 80;
    server_name localhost;
    server_tokens off;

    client_max_body_size 600M;

    set $req_id $request_id;
    if ($http_x_request_id != "") {
        set $req_id $http_x_request_id;
    }

    # Session introspection → IAM (mint internal JWT for domain routes)
    location = /_gateway_auth {
        internal;
        proxy_pass http://iam_upstream/int/v1/gateway/auth;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Gateway-Internal-Secret ${GATEWAY_INTERNAL_SECRET};
        proxy_set_header X-Request-Id $req_id;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Company $http_x_company;
    }

    location /health {
        proxy_pass http://monolith;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Request-Id $req_id;
    }

    # --- iam-service (auth, users, orgs, settings, files, webhooks, …) ---
    location ~ ^/int/v1/(auth|users|companies|settings|files|roles|policies|groups|permissions|onboard|installer|lookup|two-fa|api-|webhook|notification|dashboard|metric|activit|extension|categor|comment|custom-field|chat|user-device|schedule|template|report|transaction|gateway) {
        proxy_pass http://iam_upstream;
        include /etc/nginx/proxy_params.conf;
    }

    # --- fleetops-service ---
    # Console FleetOps uses /int/v1/orders, /int/v1/routes, … as well as /int/v1/fleet-ops/*
    location ~ ^/(int/v1/(?!auth|users|companies|settings|files|roles|policies|groups|permissions|onboard|installer|lookup|two-fa|api-|webhook|notification|dashboard|metric|activit|extension|categor|comment|custom-field|chat|user-device|schedule|template|report|transaction|gateway)|fleet-ops) {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        proxy_pass http://fleetops_upstream;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    # --- pallet-service ---
    location ~ ^/pallet/ {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        proxy_pass http://pallet_upstream;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    # --- ledger-service ---
    location ~ ^/ledger {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        proxy_pass http://ledger_upstream;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    # --- storefront-service ---
    location ~ ^/storefront/ {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        proxy_pass http://storefront_upstream;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    # --- yms-service (Yard Management — JWT validated by FastAPI) ---
    location ~ ^/api/yms/ {
        include /etc/nginx/cors_preflight.conf;
        rewrite ^/api/yms/(.*)$ /api/$1 break;
        proxy_pass http://yms_upstream;
        include /etc/nginx/proxy_params.conf;
    }

    # --- pms-service (Parking Management — JWT validated by FastAPI) ---
    location ~ ^/api/pms/ {
        include /etc/nginx/cors_preflight.conf;
        rewrite ^/api/pms/(.*)$ /api/v1/$1 break;
        proxy_pass http://pms_upstream;
        include /etc/nginx/proxy_params.conf;
    }

    # --- registry (monolith; Laravel prefix is ~registry — rewrite /registry/v1 → /~registry/v1) ---
    location ~ ^/registry/ {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        rewrite ^/registry/(.*)$ /~registry/$1 break;
        proxy_pass http://monolith;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    location ~ ^/~registry/ {
        include /etc/nginx/cors_preflight.conf;
        auth_request /_gateway_auth;
        auth_request_set $service_auth $upstream_http_x_service_authorization;
        auth_request_set $gateway_user $upstream_http_x_user_uuid;
        auth_request_set $gateway_company $upstream_http_x_company_uuid;
        proxy_pass http://monolith;
        include /etc/nginx/proxy_params.conf;
        include /etc/nginx/proxy_service_auth.conf;
    }

    # Default: monolith (registry + any unmatched paths)
    location / {
        proxy_pass http://monolith;
        include /etc/nginx/proxy_params.conf;
    }
}
