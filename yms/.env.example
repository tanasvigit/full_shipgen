POSTGRES_DB=smart_yard
POSTGRES_USER=smart_yard_user
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://smart_yard_user:postgres@postgres:5432/smart_yard
CORS_ORIGINS=http://localhost:3001
# Required: cryptographically random secret, minimum 32 characters (generate per environment).
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
ENABLE_DEV_ROLE_OVERRIDE=false
NODE_ENV=development
REACT_APP_API_BASE_URL=http://localhost:8001/api