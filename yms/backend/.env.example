# Local Docker Postgres (host port 5433) — password must match POSTGRES_PASSWORD in ../.env
DATABASE_URL=postgresql://smart_yard_user:postgress@localhost:5433/smart_yard
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# JWT authentication (required, minimum 32 characters, no placeholders)
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Dev-only: allow X-YMS-Role / X-YMS-User header override (local development)
ENABLE_DEV_ROLE_OVERRIDE=false
# Legacy dev role default when override is enabled
YMS_DEFAULT_ROLE=yard_manager
NODE_ENV=development
