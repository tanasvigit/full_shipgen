# Development image: CRA dev server with hot reload (slower startup; use compose profile "dev").
FROM node:22-alpine

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps && npm install ajv@^8.17.1 ajv-keywords@^5.1.0 --legacy-peer-deps

COPY . .

EXPOSE 3000

ENV BROWSER=none
ENV CHOKIDAR_USEPOLLING=true
ENV WATCHPACK_POLLING=true
ENV WDS_SOCKET_PORT=0

CMD ["npm", "start"]
