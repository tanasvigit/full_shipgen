#parse('partials/heading')
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4B5563;">Your login credentials for <strong>$brandName</strong> are below.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:linear-gradient(180deg,#F8FAFF 0%,#F5F6F8 100%);border:1px solid rgba(0,102,255,0.12);border-radius:12px;">
  <tr>
    <td style="padding:20px 22px;">
      <p style="margin:0 0 14px;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#7C3AED;font-weight:700;">Login credentials</p>
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:88px;font-weight:600;color:#0A0E1A;">Email</span> <span style="color:#0066FF;">$userEmail</span></p>
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:88px;font-weight:600;color:#0A0E1A;">Password</span> <code style="font-size:14px;background:#FFFFFF;border:1px solid rgba(10,14,26,0.08);border-radius:6px;padding:4px 8px;color:#0A0E1A;">$plaintextPassword</code></p>
#if($customerPortalUrl && $customerPortalUrl != '')
      <p style="margin:0;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:88px;font-weight:600;color:#0A0E1A;">Portal</span> <a href="$customerPortalUrl" style="color:#0066FF;text-decoration:none;">$customerPortalUrl</a></p>
#end
    </td>
  </tr>
</table>
#if($customerPortalUrl && $customerPortalUrl != '')
#set($actionUrl = $customerPortalUrl)
#set($actionLabel = "Open Customer Portal")
#parse('partials/cta')
#end
#set($footerNoteBody = "Change your password after first login and do not share these credentials.")
#parse('partials/muted-note')
