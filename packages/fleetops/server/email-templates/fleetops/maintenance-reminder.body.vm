<h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;font-weight:800;color:#0A0E1A;">Maintenance due: $scheduleName</h1>
#if($assigneeName && $assigneeName != '')<p style="margin:0 0 12px;font-size:15px;line-height:1.6;color:#4B5563;">Dear <strong>$assigneeName</strong>,</p>#end
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4B5563;">$reminderMessage</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:linear-gradient(180deg,#F8FAFF 0%,#F5F6F8 100%);border:1px solid rgba(0,102,255,0.12);border-radius:12px;">
  <tr>
    <td style="padding:20px 22px;font-size:14px;line-height:1.8;color:#4B5563;">
      <p style="margin:0 0 8px;"><strong style="color:#0A0E1A;">Schedule:</strong> $scheduleName</p>
#if($targetName && $targetName != '')<p style="margin:0 0 8px;"><strong style="color:#0A0E1A;">Asset:</strong> $targetName</p>#end
      <p style="margin:0 0 8px;"><strong style="color:#0A0E1A;">Type:</strong> $scheduleType</p>
      <p style="margin:0 0 8px;"><strong style="color:#0A0E1A;">Due date:</strong> $dueDate</p>
      <p style="margin:0 0 8px;"><strong style="color:#0A0E1A;">Interval:</strong> $intervalLabel</p>
      <p style="margin:0;"><strong style="color:#0A0E1A;">Priority:</strong> $priority</p>
    </td>
  </tr>
</table>
#if($instructions && $instructions != '')
<p style="margin:16px 0 0;font-size:14px;line-height:1.6;color:#4B5563;"><strong style="color:#0A0E1A;">Instructions:</strong><br/>$instructions</p>
#end
#set($footerNoteBody = "Please do not reply directly to this email. Contact your fleet manager if you have questions.")
#parse('partials/muted-note')
