#parse('partials/heading')
<p style="margin:0 0 24px;font-size:15px;line-height:1.6;color:#4B5563;">
  Your <strong style="color:#0066FF;">$brandName</strong> account password has been updated for
  <strong>$companyName</strong>. Use the credentials below to sign in to your console.
</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:linear-gradient(180deg,#F8FAFF 0%,#F5F6F8 100%);border:1px solid rgba(0,102,255,0.12);border-radius:12px;">
  <tr>
    <td style="padding:20px 22px;">
      <p style="margin:0 0 14px;font-size:11px;letter-spacing:0.18em;text-transform:uppercase;color:#7C3AED;font-weight:700;">Login credentials</p>
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;">
        <span class="field-label" style="display:inline-block;min-width:88px;color:#0A0E1A;font-weight:600;">Email</span>
        <span class="field-value" style="color:#0066FF;">$userEmail</span>
      </p>
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;">
        <span class="field-label" style="display:inline-block;min-width:88px;color:#0A0E1A;font-weight:600;">Password</span>
        <code style="font-size:14px;background:#FFFFFF;border:1px solid rgba(10,14,26,0.08);border-radius:6px;padding:4px 8px;color:#0A0E1A;">$plaintextPassword</code>
      </p>
      <p style="margin:0;font-size:14px;line-height:1.5;color:#4B5563;">
        <span class="field-label" style="display:inline-block;min-width:88px;color:#0A0E1A;font-weight:600;">Console</span>
        <a href="$consoleUrl" style="color:#0066FF;text-decoration:none;">$consoleUrl</a>
      </p>
    </td>
  </tr>
</table>
#set($actionUrl = $consoleUrl)
#set($actionLabel = 'Open Shipgen Console')
#parse('partials/cta')
#set($footerNoteBody = "For your security, change this password after your first login and do not share these credentials. If you did not request this change, contact your organization administrator immediately.")
#parse('partials/muted-note')
