<h1 style="margin:0 0 12px;font-size:24px;line-height:1.25;font-weight:800;color:#0A0E1A;">New user added</h1>
<p style="margin:0 0 16px;font-size:15px;line-height:1.6;color:#4B5563;">A new user has been added to your organization on <strong style="color:#0066FF;">$brandName</strong>.</p>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background:linear-gradient(180deg,#F8FAFF 0%,#F5F6F8 100%);border:1px solid rgba(0,102,255,0.12);border-radius:12px;">
  <tr>
    <td style="padding:20px 22px;">
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:72px;font-weight:600;color:#0A0E1A;">Name</span> $userName</p>
      <p style="margin:0 0 10px;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:72px;font-weight:600;color:#0A0E1A;">Email</span> <span style="color:#0066FF;">$userEmail</span></p>
#if($userPhone && $userPhone != '')
      <p style="margin:0;font-size:14px;line-height:1.5;color:#4B5563;"><span style="display:inline-block;min-width:72px;font-weight:600;color:#0A0E1A;">Phone</span> $userPhone</p>
#end
    </td>
  </tr>
</table>
