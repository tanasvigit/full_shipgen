<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="format-detection" content="telephone=no,address=no,email=no,date=no,url=no" />
  <title>$!emailTitle</title>
  <style type="text/css">
    #outlook a { padding: 0; }
    body { margin: 0; padding: 0; width: 100% !important; -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { border-collapse: collapse; mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { border: 0; outline: none; text-decoration: none; -ms-interpolation-mode: bicubic; display: block; }
    a { color: #0066FF; }
    @media only screen and (max-width: 620px) {
      .email-container { width: 100% !important; max-width: 100% !important; }
      .content-cell { padding: 28px 20px !important; }
      .header-cell { padding: 32px 20px 24px !important; }
      .footer-cell { padding: 20px !important; }
      .field-label { display: block !important; min-width: 0 !important; margin-bottom: 4px !important; }
      .field-value { display: block !important; }
      .cta-link { display: block !important; width: 100% !important; box-sizing: border-box !important; text-align: center !important; }
    }
  </style>
</head>
<body style="margin:0;padding:0;background-color:#F5F6F8;font-family:Arial,Helvetica,sans-serif;color:#0A0E1A;">
#if($preheader && $preheader != '')
  <div style="display:none;font-size:1px;line-height:1px;max-height:0;max-width:0;opacity:0;overflow:hidden;mso-hide:all;">$preheader</div>
#end
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="background-color:#F5F6F8;padding:32px 16px;">
    <tr>
      <td align="center">
        <table role="presentation" class="email-container" width="600" cellspacing="0" cellpadding="0" border="0" style="max-width:600px;width:100%;">
          <tr>
            <td class="header-cell" align="center" bgcolor="#0066FF" style="border-radius:16px 16px 0 0;background-color:#0066FF;background-image:linear-gradient(135deg,#0066FF 0%,#7C3AED 100%);padding:36px 32px 28px;text-align:center;">
              <img src="$logoUrl" alt="$brandName" width="180" style="margin:0 auto 16px;max-width:180px;width:180px;height:auto;" />
              <p style="margin:0;font-size:11px;letter-spacing:0.22em;text-transform:uppercase;color:rgba(255,255,255,0.85);font-family:Consolas,Monaco,monospace;">
                $!headerTagline
              </p>
            </td>
          </tr>
          <tr>
            <td class="content-cell" style="background-color:#FFFFFF;border-left:1px solid rgba(10,14,26,0.06);border-right:1px solid rgba(10,14,26,0.06);padding:36px 32px 28px;">
              $bodyContent
            </td>
          </tr>
          <tr>
            <td class="footer-cell" style="border-radius:0 0 16px 16px;background-color:#0A0E1A;border:1px solid #0A0E1A;padding:20px 32px;text-align:center;">
              <p style="margin:0 0 6px;font-size:13px;font-weight:700;color:#FFFFFF;letter-spacing:0.04em;">$brandName</p>
              <p style="margin:0;font-size:11px;line-height:1.5;color:rgba(255,255,255,0.55);">&copy; $year $brandName. All rights reserved.</p>
#if($footerNote && $footerNote != '')
              <p style="margin:10px 0 0;font-size:11px;line-height:1.5;color:rgba(255,255,255,0.45);">$footerNote</p>
#end
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
